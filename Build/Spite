/*******************************************************************************************
*
* Raylib Top-Down Shooter - Fixed & Runnable Version
* * Changes made from original:
* 1. Removed non-breaking spaces causing compilation errors.
* 2. Added 'LoadTextureFallback' to generate graphics if PNG files are missing.
* 3. Formatted indentation.
* 4. Added Dash Invincibility (No damage while dashing).
* 5. Added Health Packs (10% drop rate from minions).
*
********************************************************************************************/


#include "raylib.h"
#include <math.h>
#include <stdlib.h>
#include <stdio.h>

#define MAX_BULLETS 128
#define MAX_ENEMIES 64
#define MAX_HEALTH_PACKS 32

// ----------------------------------------------------------------------------------
// Types and Structures Definition
// ----------------------------------------------------------------------------------

// โครงสร้างข้อมูลอาวุธ
typedef struct {
    int damage;             // ความแรง
    int maxAmmo;            // กระสุนสูงสุด
    int currentAmmo;        // กระสุนปัจจุบัน
    float fireRate;         // ความเร็วในการยิง (วินาที)
    float reloadDuration;   // เวลาที่ใช้รีโหลด
    Texture2D texture;      // รูปตัวละครขณะถือปืนนี้
    
    // สถานะเฉพาะของปืน
    float fireCooldown;     // นับถอยหลังเวลารอยิง
    int isReloading;        // กำลังรีโหลดอยู่ไหม
    float reloadTimer;      // นับเวลารีโหลด
} Weapon;

// โครงสร้างกระสุน
typedef struct {
    Vector2 pos;
    Vector2 vel;
    float radius;
    int alive;
} Bullet;

// โครงสร้างศัตรู
typedef struct {
    Vector2 pos;
    float speed;
    float radius;
    int alive;
    int hp;
    int maxHp;
    int type; // 0 = Normal (Robot), 1 = Boss (Runner)
} Enemy;

// โครงสร้างกล่องพยาบาล
typedef struct {
    Vector2 pos;
    float radius;
    int active;
} HealthPack;

// โครงสร้างผู้เล่น
typedef struct {
    Vector2 pos;
    float speed;
    float radius;
    int hp;
    int maxHp; // เพิ่มตัวแปรเลือดสูงสุด
    
    Weapon weapons[2];      // เก็บปืน 2 กระบอก
    int currentWeaponIdx;   // 0 หรือ 1
    
    // Dash
    float dashCooldown;
    int isDashing;
    float dashTimer;
} GamePlayer;

// ฟังก์ชันช่วยคำนวณ (Clamp)
static float Clampf(float v, float lo, float hi) {
    return (v < lo) ? lo : (v > hi) ? hi : v;
}

// ฟังก์ชันโหลด Texture ถ้าหาไฟล์ไม่เจอจะสร้างสี่เหลี่ยมสีแทน (เพื่อให้รันได้ทันที)
Texture2D LoadTextureFallback(const char* fileName, int width, int height, Color color, const char* text) {
    if (FileExists(fileName)) {
        return LoadTexture(fileName);
    }
    
    // สร้าง Image สีพื้น
    Image img = GenImageColor(width, height, color);
    
    // วาดข้อความระบุว่าเป็นอะไร (เช่น PISTOL, ENEMY)
    if (width > 40 && height > 20) {
        ImageDrawText(&img, text, 5, height/3, 10, BLACK);
        // วาดกรอบ
        ImageDrawRectangleLines(&img, (Rectangle){0,0, (float)width, (float)height}, 2, BLACK);
    }

    Texture2D tex = LoadTextureFromImage(img);
    UnloadImage(img);
    return tex;
}

// ----------------------------------------------------------------------------------
// Module Functions Declaration
// ----------------------------------------------------------------------------------

// ฟังก์ชันเสกกล่องพยาบาล
static void SpawnHealthPack(HealthPack* packs, Vector2 position) {
    for (int i = 0; i < MAX_HEALTH_PACKS; i++) {
        if (!packs[i].active) {
            packs[i].pos = position;
            packs[i].radius = 15.0f;
            packs[i].active = 1;
            break;
        }
    }
}

// ฟังก์ชันรีเซ็ตเกม
static void ResetGame(GamePlayer* player, Bullet* bullets, 
                      Enemy* enemies, int* enemyCount,
                      HealthPack* healthPacks, // เพิ่ม HealthPacks
                      float* enemySpawnTimer, float* enemySpawnInterval, 
                      int* score, int* wave, int* gameOver,
                      int screenW, int screenH,
                      int* enemiesPerWave, int* enemiesSpawned, int* enemiesRemaining,
                      int* waveTransition, float* waveTimer) {

    player->pos = (Vector2){(float)screenW/2.0f, (float)screenH/2.0f};
    player->speed = 300.0f; 
    player->radius = 24.0f;
    player->maxHp = 5; // เลือดสูงสุดเริ่มต้น
    player->hp = player->maxHp;
    
    player->isDashing = 0;
    player->dashTimer = 0.0f;
    player->dashCooldown = 0.0f;
    
    // Reset Pistol (Weapon 0)
    player->weapons[0].currentAmmo = player->weapons[0].maxAmmo;
    player->weapons[0].isReloading = 0;
    player->weapons[0].reloadTimer = 0.0f;
    player->weapons[0].fireCooldown = 0.0f;

    // Reset Rifle (Weapon 1)
    player->weapons[1].currentAmmo = player->weapons[1].maxAmmo;
    player->weapons[1].isReloading = 0;
    player->weapons[1].reloadTimer = 0.0f;
    player->weapons[1].fireCooldown = 0.0f;

    player->currentWeaponIdx = 0; 

    // Clear Entities
    for (int i = 0; i < MAX_BULLETS; i++) bullets[i].alive = 0;
    for (int i = 0; i < MAX_HEALTH_PACKS; i++) healthPacks[i].active = 0;

    *enemyCount = 0;
    for (int i = 0; i < MAX_ENEMIES; i++) enemies[i].alive = 0;

    *enemySpawnTimer = 0.0f;
    *enemySpawnInterval = 1.0f;
    *score = 0;
    *wave = 1;
    *gameOver = 0;
    
    *enemiesPerWave = 5;
    *enemiesSpawned = 0;
    *enemiesRemaining = 5;

    *waveTransition = 0;
    *waveTimer = 0.0f;
}

// ฟังก์ชันเสกศัตรู
static void SpawnEnemy(Enemy* enemies, int* enemyCount, Rectangle arena, int wave, int type) {
    if (*enemyCount >= MAX_ENEMIES) return; 
    
    Enemy e;
    // สุ่มจุดเกิดรอบขอบ Arena
    int edge = GetRandomValue(0, 3);
    switch (edge) {
        case 0: e.pos = (Vector2){arena.x, (float)GetRandomValue((int)arena.y, (int)(arena.y + arena.height))}; break;
        case 1: e.pos = (Vector2){arena.x + arena.width, (float)GetRandomValue((int)arena.y, (int)(arena.y + arena.height))}; break;
        case 2: e.pos = (Vector2){(float)GetRandomValue((int)arena.x, (int)(arena.x + arena.width)), arena.y}; break;
        default: e.pos = (Vector2){(float)GetRandomValue((int)arena.x, (int)(arena.x + arena.width)), arena.y + arena.height}; break;
    }
    
    e.type = type;

    if (type == 1) { 
        // *** BOSS STATS ***
        e.maxHp = 300 + (wave / 5) * 200; 
        float baseSpeed = 120.0f + wave * 20.0f;
        e.speed = baseSpeed * (0.9f + (float)GetRandomValue(0, 20)/100.0f);
        e.radius = 75.0f; 
    } else {
        // *** NORMAL STATS ***
        e.maxHp = 100 + (wave - 1) * 20;
        float baseSpeed = 200.0f + wave * 5.0f; 
        e.speed = baseSpeed * (0.85f + (float)GetRandomValue(0, 30)/100.0f);
        e.radius = 20.0f;
    }
    
    e.hp = e.maxHp; 
    e.alive = 1;
    enemies[(*enemyCount)++] = e; 
}

// ----------------------------------------------------------------------------------
// Main Entry Point
// ----------------------------------------------------------------------------------
int main(void) {
    const int screenW = 1600; 
    const int screenH = 900; 
    InitWindow(screenW, screenH, "Top-Down Shooter - Raylib");
    
    SetTargetFPS(60);
    
    // --- LOAD ASSETS ---
    Texture2D background = LoadTextureFallback("Map1024x768.png", 1024, 768, DARKGRAY, "MAP"); 
    Texture2D texPistol = LoadTextureFallback("MainC_Pistol.png", 100, 100, BLUE, "PISTOL"); 
    Texture2D texRifle = LoadTextureFallback("MainC_Rifle.png", 100, 100, ORANGE, "RIFLE"); 
    Texture2D enemyTexture = LoadTextureFallback("Robot_Melee.png", 85, 85, RED, "ENEMY"); 
    Texture2D runnerTexture = LoadTextureFallback("Runner.png", 180, 180, PURPLE, "BOSS");     
    
    Rectangle sourceRec = { 0, 0, (float)background.width, (float)background.height };
    Rectangle destRec = { 0, 0, (float)screenW, (float)screenH }; 
    
    const float playerSize = 100.0f; 
    Vector2 playerOrigin = { playerSize / 2.0f, playerSize / 2.0f };

    HideCursor(); 

    Rectangle arena = (Rectangle){40, 40, (float)screenW - 80, (float)screenH - 80};

    // --- Setup Player & Weapons ---
    GamePlayer player = {0};
    
    // Weapon 0: Pistol
    player.weapons[0].damage = 50;
    player.weapons[0].maxAmmo = 12;
    player.weapons[0].fireRate = 0.25f;
    player.weapons[0].reloadDuration = 1.5f;
    player.weapons[0].texture = texPistol;
    
    // Weapon 1: Rifle
    player.weapons[1].damage = 30;
    player.weapons[1].maxAmmo = 30;
    player.weapons[1].fireRate = 0.10f;
    player.weapons[1].reloadDuration = 2.0f; 
    player.weapons[1].texture = texRifle;

    Bullet bullets[MAX_BULLETS] = {0};
    Enemy enemies[MAX_ENEMIES] = {0};
    HealthPack healthPacks[MAX_HEALTH_PACKS] = {0}; // สร้าง Array เก็บกล่องพยาบาล

    int enemyCount = 0;
    float enemySpawnTimer = 0.0f;
    float enemySpawnInterval = 1.0f;
    int score = 0, wave = 1;
    int gameOver = 0;
    
    int enemiesPerWave = 5; 
    int enemiesSpawned = 0;           
    int enemiesRemaining = 5; 

    // Dash Config
    Vector2 dashDirection = {0, 0}; 
    const float dashDuration = 0.2f;
    const float dashSpeed = 800.0f; 
    const float dashCooldownTime = 1.0f;

    // Wave Transition
    int waveTransition = 0; 
    float waveTimer = 0.0f; 

    int gameState = 0; // 0 = Start Screen, 1 = Gameplay
    ShowCursor(); 
    
    // ----------------------------------------------------------------------------------
    // Main Game Loop
    // ----------------------------------------------------------------------------------
    while (!WindowShouldClose()) {
        float dt = GetFrameTime();

        // --- START SCREEN ---
        if (gameState == 0) {
            if (IsMouseButtonPressed(MOUSE_BUTTON_LEFT)) {
                ResetGame(&player, bullets, enemies, &enemyCount, healthPacks,
                          &enemySpawnTimer, &enemySpawnInterval,
                          &score, &wave, &gameOver, screenW, screenH,
                          &enemiesPerWave, &enemiesSpawned, &enemiesRemaining,
                          &waveTransition, &waveTimer); 
                gameState = 1; 
                HideCursor(); 
            }
        }
        // --- GAMEPLAY ---
        else if (gameState == 1) { 
            
            if (!gameOver) {
                // --- Input: Weapon Switching ---
                int prevWeaponIdx = player.currentWeaponIdx;
                if (IsKeyPressed(KEY_ONE)) player.currentWeaponIdx = 0;
                if (IsKeyPressed(KEY_TWO)) player.currentWeaponIdx = 1;
                
                // Cancel reload if switched
                if (prevWeaponIdx != player.currentWeaponIdx) {
                    player.weapons[prevWeaponIdx].isReloading = 0;
                    player.weapons[prevWeaponIdx].reloadTimer = 0.0f;
                }
                
                // --- Update Weapons ---
                for (int i = 0; i < 2; i++) {
                    Weapon *w = &player.weapons[i];
                    if (w->fireCooldown > 0.0f) w->fireCooldown -= dt;
                    
                    if (w->isReloading) {
                        w->reloadTimer += dt;
                        if (w->reloadTimer >= w->reloadDuration) {
                            w->currentAmmo = w->maxAmmo; 
                            w->isReloading = 0;
                            w->reloadTimer = 0.0f;
                            w->fireCooldown = 0.0f; 
                        }
                    }
                }

                Weapon *currentWpn = &player.weapons[player.currentWeaponIdx];

                // --- Input: Movement ---
                Vector2 move = (Vector2){0, 0};
                if (IsKeyDown(KEY_W) || IsKeyDown(KEY_UP)) move.y -= 1;
                if (IsKeyDown(KEY_S) || IsKeyDown(KEY_DOWN)) move.y += 1;
                if (IsKeyDown(KEY_A) || IsKeyDown(KEY_LEFT)) move.x -= 1;
                if (IsKeyDown(KEY_D) || IsKeyDown(KEY_RIGHT)) move.x += 1;

                float mag = sqrtf(move.x*move.x + move.y*move.y);
                if (mag > 0.0f) { move.x /= mag; move.y /= mag; } 

                Vector2 mouse = GetMousePosition();
                Vector2 aim = (Vector2){ mouse.x - player.pos.x, mouse.y - player.pos.y };
                float aimLen = sqrtf(aim.x*aim.x + aim.y*aim.y);
                if (aimLen > 0.0f) { aim.x /= aimLen; aim.y /= aimLen; } 

                // --- Logic: Dash ---
                if (player.isDashing) {
                    player.dashTimer += dt;
                    player.pos.x += dashDirection.x * dashSpeed * dt;
                    player.pos.y += dashDirection.y * dashSpeed * dt;

                    if (player.dashTimer >= dashDuration) {
                        player.isDashing = 0;
                        player.dashCooldown = dashCooldownTime;
                    }
                } 
                else {
                    if (player.dashCooldown > 0.0f) player.dashCooldown -= dt;

                    if (IsKeyPressed(KEY_SPACE) && player.dashCooldown <= 0.0f) {
                        player.isDashing = 1;
                        player.dashTimer = 0.0f;
                        dashDirection = (mag > 0.0f) ? move : aim;
                    }

                    player.pos.x += move.x * player.speed * dt;
                    player.pos.y += move.y * player.speed * dt;
                }

                // Clamp Position
                player.pos.x = Clampf(player.pos.x, arena.x + player.radius, arena.x + arena.width - player.radius);
                player.pos.y = Clampf(player.pos.y, arena.y + player.radius, arena.y + arena.height - player.radius);

                // --- Input: Reload ---
                if (!currentWpn->isReloading) {
                    if (IsKeyPressed(KEY_R) || (IsMouseButtonDown(MOUSE_BUTTON_LEFT) && currentWpn->currentAmmo == 0)) {
                        if (currentWpn->currentAmmo < currentWpn->maxAmmo) { 
                            currentWpn->isReloading = 1;
                            currentWpn->reloadTimer = 0.0f;
                        }
                    }
                }

                // --- Input: Shooting ---
                if (!player.isDashing && IsMouseButtonDown(MOUSE_BUTTON_LEFT) && 
                    currentWpn->fireCooldown <= 0.0f && !currentWpn->isReloading && currentWpn->currentAmmo > 0) {
                    
                    int freeIndex = -1;
                    for (int i = 0; i < MAX_BULLETS; i++) {
                        if (bullets[i].alive == 0) {
                            freeIndex = i;
                            break;
                        }
                    }

                    if (freeIndex != -1) {
                        Bullet b;
                        float bulletSpeed = 600.0f; 
                        b.pos = (Vector2){ player.pos.x + aim.x * player.radius, player.pos.y + aim.y * player.radius };
                        b.vel = (Vector2){ aim.x * bulletSpeed, aim.y * bulletSpeed };
                        b.radius = 4.0f;
                        b.alive = 1;
                        bullets[freeIndex] = b; 
                        
                        currentWpn->fireCooldown = currentWpn->fireRate; 
                        currentWpn->currentAmmo--; 
                    }
                }

                // --- Logic: Spawning ---
                if (waveTransition) {
                    waveTimer -= dt;
                    if (waveTimer <= 0.0f) {
                        // Start New Wave
                        waveTransition = 0;
                        wave++;
                        
                        int baseMinions = 5 + (wave - 1);
                        if (wave % 5 == 0) enemiesPerWave = baseMinions + 1;
                        else enemiesPerWave = baseMinions;
                        
                        enemiesSpawned = 0;
                        enemySpawnTimer = 0.0f;
                    }
                } 
                else {
                    enemySpawnTimer += dt;
                    if (enemiesSpawned < enemiesPerWave && enemySpawnTimer >= enemySpawnInterval) {
                        int typeToSpawn = 0; // Normal
                        if (wave % 5 == 0 && enemiesSpawned == enemiesPerWave - 1) {
                            typeToSpawn = 1; // Boss (Last one)
                        }
                        
                        SpawnEnemy(enemies, &enemyCount, arena, wave, typeToSpawn);
                        enemySpawnTimer = 0.0f;
                        enemiesSpawned++;
                        
                        if (wave % 5 != 0) enemySpawnInterval = fmaxf(0.35f, 1.0f - (wave - 1) * 0.05f); 
                        else enemySpawnInterval = 0.8f; 
                    }
                    
                    if (enemiesSpawned >= enemiesPerWave && enemiesRemaining <= 0) {
                        waveTransition = 1;
                        waveTimer = 7.0f; 
                    }
                }

                // --- Logic: Updates & Collisions (Only if not Game Over) ---
                
                // Update Enemies
                for (int i = 0; i < enemyCount; i++) {
                    if (!enemies[i].alive) continue;
                    Vector2 dir = (Vector2){ player.pos.x - enemies[i].pos.x, player.pos.y - enemies[i].pos.y };
                    float d = sqrtf(dir.x*dir.x + dir.y*dir.y);
                    if (d > 0.0f) { dir.x /= d; dir.y /= d; }
                    enemies[i].pos.x += dir.x * enemies[i].speed * dt;
                    enemies[i].pos.y += dir.y * enemies[i].speed * dt;
                }
                
                // Collision: Enemies vs Player
                for (int j = 0; j < enemyCount; j++) {
                    if (!enemies[j].alive) continue;
                    float dx = player.pos.x - enemies[j].pos.x;
                    float dy = player.pos.y - enemies[j].pos.y;
                    float r = player.radius + enemies[j].radius;
                    
                    // ตรวจสอบการชน
                    if (dx*dx + dy*dy <= r*r) {
                        // *** DASH INVINCIBILITY (อมตะขณะแดช) ***
                        // ถ้ากำลัง Dash อยู่ (isDashing = 1) จะไม่เข้าเงื่อนไขนี้
                        if (!player.isDashing) {
                            enemies[j].alive = 0;
                            player.hp--;
                            if (player.hp <= 0) gameOver = 1;
                        }
                    }
                }

                // Check Collection of Health Packs
                for (int i = 0; i < MAX_HEALTH_PACKS; i++) {
                    if (healthPacks[i].active) {
                        float dx = player.pos.x - healthPacks[i].pos.x;
                        float dy = player.pos.y - healthPacks[i].pos.y;
                        float r = player.radius + healthPacks[i].radius;
                        if (dx*dx + dy*dy <= r*r) {
                            // Collect pack
                            healthPacks[i].active = 0;
                            if (player.hp < player.maxHp) {
                                player.hp++;
                            }
                        }
                    }
                }
            
            } else { // Game Over
                if (IsKeyPressed(KEY_R)) {
                    ResetGame(&player, bullets, enemies, &enemyCount, healthPacks,
                              &enemySpawnTimer, &enemySpawnInterval,
                              &score, &wave, &gameOver, screenW, screenH,
                              &enemiesPerWave, &enemiesSpawned, &enemiesRemaining,
                              &waveTransition, &waveTimer); 
                }
            }

            // --- GLOBAL BULLET LOGIC ---
            for (int i = 0; i < MAX_BULLETS; i++) {
                if (!bullets[i].alive) continue;
                bullets[i].pos.x += bullets[i].vel.x * dt;
                bullets[i].pos.y += bullets[i].vel.y * dt;
                if (bullets[i].pos.x < arena.x || bullets[i].pos.x > arena.x + arena.width ||
                    bullets[i].pos.y < arena.y || bullets[i].pos.y > arena.y + arena.height) {
                    bullets[i].alive = 0;
                }
            }

            // Collision: Bullets vs Enemies
            if (!gameOver) {
                Weapon *currentWpn = &player.weapons[player.currentWeaponIdx];
                for (int i = 0; i < MAX_BULLETS; i++) { 
                    if (!bullets[i].alive) continue;
                    for (int j = 0; j < enemyCount; j++) {
                        if (!enemies[j].alive) continue;
                        float dx = bullets[i].pos.x - enemies[j].pos.x;
                        float dy = bullets[i].pos.y - enemies[j].pos.y;
                        float r = bullets[i].radius + enemies[j].radius;
                        if (dx*dx + dy*dy <= r*r) {
                            bullets[i].alive = 0; 
                            enemies[j].hp -= currentWpn->damage;
                            
                            // Enemy Dies
                            if (enemies[j].hp <= 0) {
                                enemies[j].alive = 0; 
                                score += (enemies[j].type == 1) ? 50 : 1;
                                
                                // *** HEALTH PACK DROP LOGIC ***
                                // เฉพาะลูกสมุน (Type 0) มีโอกาส 10% (สุ่ม 0-99 < 10)
                                if (enemies[j].type == 0) {
                                    if (GetRandomValue(0, 99) < 10) {
                                        SpawnHealthPack(healthPacks, enemies[j].pos);
                                    }
                                }
                            }
                            break;
                        }
                    }
                }
            }

            // Enemy List Compaction
            enemiesRemaining = 0;
            int writeIndex = 0;
            for (int readIndex = 0; readIndex < enemyCount; readIndex++) {
                if (enemies[readIndex].alive) {
                    if (readIndex != writeIndex) {
                        enemies[writeIndex] = enemies[readIndex];
                    }
                    writeIndex++;
                    enemiesRemaining++;
                }
            }
            enemyCount = writeIndex;
        }

        // ----------------------------------------------------------------------------------
        // Draw
        // ----------------------------------------------------------------------------------
        BeginDrawing();
        ClearBackground((Color){20, 22, 28, 255}); 

        if (gameState == 0) {
            ShowCursor();
            const char *title = "TOP-DOWN SHOOTER";
            const char *instruction = "Click Left Mouse Button to START";
            DrawText(title, screenW/2 - MeasureText(title, 40)/2, screenH/2 - 60, 40, (Color){150, 255, 150, 255});
            DrawText(instruction, screenW/2 - MeasureText(instruction, 22)/2, screenH/2 + 20, 22, RAYWHITE);
            
        } else { 
            if (gameOver) ShowCursor(); else HideCursor();
            
            // Draw Background & Arena
            DrawTexturePro(background, sourceRec, destRec, (Vector2){0, 0}, 0.0f, RAYWHITE);
            DrawRectangleLinesEx(arena, 2.0f, (Color){110, 120, 150, 255});

            // Player Rotation Calculation
            Vector2 mouse = GetMousePosition();
            Vector2 aim = (Vector2){ mouse.x - player.pos.x, mouse.y - player.pos.y };
            float aimLen = sqrtf(aim.x*aim.x + aim.y*aim.y);
            float rotation = 0.0f;
            if (aimLen > 0.0f) { 
                aim.x /= aimLen; 
                aim.y /= aimLen; 
                rotation = atan2f(aim.y, aim.x) * RAD2DEG; 
            }

            // Draw Health Packs (วาดกล่องพยาบาลก่อนผู้เล่น)
            for (int i = 0; i < MAX_HEALTH_PACKS; i++) {
                if (healthPacks[i].active) {
                    // กล่องสี่เหลี่ยมสีขาว
                    float size = 30.0f;
                    DrawRectangle((int)(healthPacks[i].pos.x - size/2), (int)(healthPacks[i].pos.y - size/2), (int)size, (int)size, RAYWHITE);
                    DrawRectangleLines((int)(healthPacks[i].pos.x - size/2), (int)(healthPacks[i].pos.y - size/2), (int)size, (int)size, GRAY);
                    
                    // เครื่องหมายบวกสีเขียว
                    float plusThick = 6.0f;
                    float plusLen = 18.0f;
                    DrawRectangle((int)(healthPacks[i].pos.x - plusLen/2), (int)(healthPacks[i].pos.y - plusThick/2), (int)plusLen, (int)plusThick, GREEN); // แนวนอน
                    DrawRectangle((int)(healthPacks[i].pos.x - plusThick/2), (int)(healthPacks[i].pos.y - plusLen/2), (int)plusThick, (int)plusLen, GREEN); // แนวตั้ง
                }
            }

            // Draw Player Glow
            if (!gameOver) {
                Color glowColor = (Color){ 0, 255, 100, 255 };
                int layers = 8; 
                float baseRadius = playerSize / 6.0f; 
                for (int i = 0; i < layers; i++) {
                    float r = baseRadius + (i * 3.0f);
                    float alpha = 0.3f - (i * 0.035f);
                    if (alpha < 0.0f) alpha = 0.0f;
                    DrawCircleV(player.pos, r, Fade(glowColor, alpha));
                }
            }

            // Draw Player
            Color playerCol;
            if (gameOver) playerCol = RED;
            else if (player.isDashing) playerCol = SKYBLUE;
            else playerCol = (Color){255, 255, 255, 255};

            Weapon *drawWpn = &player.weapons[player.currentWeaponIdx];
            Rectangle playerSourceRec = { 0.0f, 0.0f, (float)drawWpn->texture.width, (float)drawWpn->texture.height };
            Rectangle playerDestRec = { player.pos.x, player.pos.y, playerSize, playerSize };
            
            DrawTexturePro(drawWpn->texture, playerSourceRec, playerDestRec, playerOrigin, rotation, playerCol);

            // Draw Reload Bar
            if (drawWpn->isReloading && !gameOver) {
                float progress = drawWpn->reloadTimer / drawWpn->reloadDuration;
                float barWidth = 40.0f; 
                float barHeight = 6.0f; 
                int barX = (int)(player.pos.x - barWidth / 2.0f);
                int barY = (int)(player.pos.y - player.radius - 25.0f); 
                
                DrawRectangle(barX, barY, (int)barWidth, (int)barHeight, (Color){50, 50, 50, 200});
                DrawRectangle(barX, barY, (int)(barWidth * progress), (int)barHeight, YELLOW);
                DrawRectangleLines(barX, barY, (int)barWidth, (int)barHeight, RAYWHITE);
                
                const char *reloadMsg = "RELOAD";
                int tw = MeasureText(reloadMsg, 10);
                DrawText(reloadMsg, barX + (int)(barWidth/2.0f) - tw/2, barY - 12, 10, YELLOW);
            }

            // Draw Bullets
            for (int i = 0; i < MAX_BULLETS; i++) {
                if (!bullets[i].alive) continue;
                DrawCircle((int)bullets[i].pos.x, (int)bullets[i].pos.y, bullets[i].radius, (Color){240, 240, 80, 255});
            }

            // Draw Enemies
            Rectangle enemySourceRec = { 0.0f, 0.0f, (float)enemyTexture.width, (float)enemyTexture.height };
            Color enemyGlowColor = (Color){ 255, 50, 50, 255 };
            int enemyGlowLayers = 6; 

            for (int i = 0; i < enemyCount; i++) {
                if (!enemies[i].alive) continue;
                
                Texture2D currentEnemyTex = (enemies[i].type == 1) ? runnerTexture : enemyTexture;
                
                // ปรับขนาดรูปวาดให้ใหญ่ขึ้นตาม Hitbox
                float currentSize = (enemies[i].type == 1) ? 260.0f : 85.0f; // Boss size: 180 -> 260
                
                Vector2 currentOrigin = { currentSize / 2.0f, currentSize / 2.0f };
                float enemyBaseRadius = currentSize / 3.0f;

                for (int j = 0; j < enemyGlowLayers; j++) {
                    float r = enemyBaseRadius + (j * 4.0f);
                    float alpha = 0.3f - (j * 0.04f);
                    if (alpha < 0.0f) alpha = 0.0f;
                    DrawCircleV(enemies[i].pos, r, Fade(enemyGlowColor, alpha));
                }
                
                float dx = player.pos.x - enemies[i].pos.x;
                float dy = player.pos.y - enemies[i].pos.y;
                float enemyRotation = atan2f(dy, dx) * RAD2DEG; 

                Rectangle enemyDestRec = { enemies[i].pos.x, enemies[i].pos.y, currentSize, currentSize };
                
                DrawTexturePro(currentEnemyTex, enemySourceRec, enemyDestRec, currentOrigin, enemyRotation, WHITE); 

                float hpPercent = (float)enemies[i].hp / (float)enemies[i].maxHp;
                if (hpPercent < 0.0f) hpPercent = 0.0f;
                
                float barWidth = (enemies[i].type == 1) ? 120.0f : 40.0f; // Boss HP bar larger
                float barHeight = 5.0f;
                float barX = enemies[i].pos.x - barWidth / 2.0f;
                float barY = enemies[i].pos.y - (currentSize/2.0f) - 10.0f; 
                
                DrawRectangle(barX, barY, barWidth, barHeight, RED);
                DrawRectangle(barX, barY, barWidth * hpPercent, barHeight, GREEN);
            }
            
            // Draw Wave Transition Overlay
            if (waveTransition && !gameOver) {
                if (waveTimer > 5.0f) {
                    const char *txt = "CLEAR!";
                    int fontSize = 80;
                    int txtW = MeasureText(txt, fontSize);
                    DrawText(txt, screenW/2 - txtW/2, screenH/2 - fontSize/2, fontSize, YELLOW);
                } else if (waveTimer > 2.0f) {
                    int count = (int)ceilf(waveTimer - 2.0f);
                    if (count > 0) {
                        const char *txt = TextFormat("%d", count);
                        int fontSize = 100;
                        int txtW = MeasureText(txt, fontSize);
                        DrawText(txt, screenW/2 - txtW/2, screenH/2 - fontSize/2, fontSize, ORANGE);
                    }
                } else {
                    // *** WAVE X Text Phase (0s - 2s) ***
                    const char *txt = TextFormat("WAVE %d", wave + 1);
                    int fontSize = 80;
                    int txtW = MeasureText(txt, fontSize);
                    DrawText(txt, screenW/2 - txtW/2, screenH/2 - fontSize/2, fontSize, RAYWHITE);

                    // *** BOSS IS COMING Logic ***
                    if ((wave + 1) % 5 == 0) {
                         const char *bossMsg = "BOSS IS COMING!";
                         int bossFontSize = 50; 
                         int bossTw = MeasureText(bossMsg, bossFontSize);
                         DrawText(bossMsg, screenW/2 - bossTw/2, screenH/2 - fontSize/2 + 85, bossFontSize, RED);
                    }
                }
            }

            // --- UI / HUD ---
            int fontSize = 30; // เพิ่มขนาด Font จากเดิม 22
            int y_start = 20;
            int y_offset = y_start;
            int x_left = 20;
            
            // คำนวณสี HP แบบไล่เฉดสี: เขียว -> เหลือง -> แดง
            float hpPct = (float)player.hp / (float)player.maxHp;
            Color hpColor = ColorFromHSV(hpPct * 120.0f, 0.8f, 0.9f);
            if (player.hp <= 1) hpColor = RED; 

            DrawText(TextFormat("HP: %d / %d", player.hp, player.maxHp), x_left, y_offset, fontSize, hpColor);
            y_offset += fontSize + 8; 
            
            DrawText(TextFormat("Score: %d", score), x_left, y_offset, fontSize, RAYWHITE);
            y_offset += fontSize + 8; 
            
            Color dashTextColor = (player.dashCooldown > 0.0f) ? GRAY : SKYBLUE;
            const char* dashText = (player.dashCooldown > 0.0f) ? "Dash: WAIT" : "Dash: READY";
            DrawText(dashText, x_left, y_offset, fontSize, dashTextColor);
            y_offset += fontSize + 8;

            DrawText(TextFormat("Enemies: %d", enemiesRemaining), x_left, y_offset, fontSize, RAYWHITE);

            const char *waveText = TextFormat("Wave: %d", wave);
            int waveTw = MeasureText(waveText, fontSize + 4); 
            DrawText(waveText, screenW/2 - waveTw/2, y_start, fontSize + 4, (Color){150, 255, 150, 255});

            DrawText("Move: WASD | Aim: Mouse | Shoot: LMB | Weapon: 1/2 | Reload: R | Dash: Space | Restart: R", 16, screenH - 30, 18, (Color){180, 180, 200, 255});

            // --- NEW UI: Active Weapon (Top Right) & Ammo (Bottom Right) ---
            
            // 1. Top-Right: Weapon Slots (Show BOTH weapons)
            int slotSize = 90; 
            int slotPadding = 15;
            int totalWidth = (slotSize * 2) + slotPadding;
            int startX = screenW - totalWidth - 30;
            int startY = 30;

            for (int i = 0; i < 2; i++) {
                int bx = startX + i * (slotSize + slotPadding);
                int by = startY;
                
                Weapon *w = &player.weapons[i];
                int isActive = (i == player.currentWeaponIdx);
                
                // Background
                DrawRectangle(bx, by, slotSize, slotSize, (Color){ 30, 30, 30, 200 });
                
                // Border Highlight
                if (isActive) {
                    DrawRectangleLinesEx((Rectangle){bx, by, slotSize, slotSize}, 3.0f, YELLOW);
                } else {
                    DrawRectangleLines(bx, by, slotSize, slotSize, GRAY);
                }
                
                // Texture
                float scale = (float)(slotSize - 20) / (float)w->texture.width;
                // Center texture
                float texX = bx + (slotSize - w->texture.width * scale) / 2;
                float texY = by + (slotSize - w->texture.height * scale) / 2;
                
                DrawTextureEx(w->texture, (Vector2){ texX, texY }, 0.0f, scale, isActive ? WHITE : Fade(WHITE, 0.6f));
                
                // Key Hint (1 or 2)
                DrawText(TextFormat("%d", i + 1), bx + 5, by + 5, 20, isActive ? YELLOW : GRAY);
                
                // Weapon Name
                const char *name = (i == 0) ? "PISTOL" : "RIFLE";
                DrawText(name, bx + 5, by + slotSize - 15, 10, isActive ? RAYWHITE : GRAY);

                // Reload Overlay (Small bar inside slot)
                if (w->isReloading) {
                    float reloadPct = w->reloadTimer / w->reloadDuration;
                    DrawRectangle(bx, by + slotSize - 5, (int)(slotSize * reloadPct), 5, YELLOW);
                }
            }

            // 2. Bottom-Right: Ammo Count (For Active Weapon)
            Weapon *currentWpn = &player.weapons[player.currentWeaponIdx];
            const char *ammoText = TextFormat("%d / %d", currentWpn->currentAmmo, currentWpn->maxAmmo);
            int ammoFontSize = 60; // ตัวเลขใหญ่
            int ammoW = MeasureText(ammoText, ammoFontSize);
            int ammoX = screenW - ammoW - 40;
            int ammoY = screenH - ammoFontSize - 40;

            // เปลี่ยนสีถ้ากระสุนหมดหรือเหลือน้อย
            Color ammoColor = (currentWpn->currentAmmo == 0) ? RED : (currentWpn->currentAmmo < currentWpn->maxAmmo * 0.3f) ? ORANGE : RAYWHITE;

            DrawText("AMMO", ammoX, ammoY - 25, 20, GRAY);
            DrawText(ammoText, ammoX, ammoY, ammoFontSize, ammoColor);

            // Crosshair
            {
                int size = 12;
                Color crossCol = (Color){255, 255, 255, 200};
                DrawLine((int)(mouse.x - size), (int)mouse.y, (int)(mouse.x + size), (int)mouse.y, crossCol);
                DrawLine((int)mouse.x, (int)(mouse.y - size), (int)mouse.x, (int)(mouse.y + size), crossCol);
                DrawCircle((int)mouse.x, (int)mouse.y, 3, crossCol);
            }

            if (gameOver) {
                const char *msg = "GAME OVER - Press R to restart";
                int tw = MeasureText(msg, 32);
                DrawText(msg, screenW/2 - tw/2, screenH/2 - 16, 32, RED);
            }
        }
        
        EndDrawing();
    }
    
    // Unload Textures
    UnloadTexture(background);
    UnloadTexture(texPistol); 
    UnloadTexture(texRifle); 
    UnloadTexture(enemyTexture); 
    UnloadTexture(runnerTexture); 

    CloseWindow();
    return 0;
}
